# ── Supabase ─────────────────────────────────────────────────────
# Dashboard → your project → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server-only secret — never expose to the frontend or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Server ───────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated origins allowed to call this API.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Where Supabase sends users after they click a password-reset email link.
PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password

# ── Admin ─────────────────────────────────────────────────────────
# Secret code users must enter during registration to get admin role.
ADMIN_SECRET_CODE=globetrotter-admin-2026
