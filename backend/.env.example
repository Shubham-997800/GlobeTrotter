# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# Supabase — Project Settings → API (dashboard.supabase.com)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# service_role key — server-side ONLY, never expose to the frontend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where Supabase password-reset emails send users (your frontend reset page)
PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password
